<Window x:Class="SiriIceCream.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:SiriIceCream.Desktop.ViewModels"
        xmlns:views="clr-namespace:SiriIceCream.Desktop.Views"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="Siri Ice Cream"
        Width="1240" Height="780" MinWidth="1000" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackgroundBrush}">

    <Window.Resources>
        <!-- Icons come from the Windows icon font -->
        <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

        <!-- Sidebar menu item. Tag="True" marks the active page (pink bar + light background). -->
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Foreground" Value="#E3CFDA" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="8" Padding="16,11">
                            <Grid>
                                <Border x:Name="Accent" Width="4" CornerRadius="2" Background="#F48FB1"
                                        HorizontalAlignment="Left" Margin="-16,2,0,2" Visibility="Collapsed" />
                                <ContentPresenter VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1AFFFFFF" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#33FFFFFF" />
                                <Setter TargetName="Accent" Property="Visibility" Value="Visible" />
                                <Setter Property="Foreground" Value="White" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- How each kind of page is shown in the main area -->
        <DataTemplate DataType="{x:Type vm:ItemsViewModel}">
            <views:ItemsView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:CustomersViewModel}">
            <views:CustomersView />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="248" /> <!-- sidebar -->
            <ColumnDefinition Width="*" />   <!-- page -->
        </Grid.ColumnDefinitions>

        <!-- ================= SIDEBAR ================= -->
        <Border Grid.Column="0" Background="#2A1222">
            <DockPanel Margin="16,22,16,18">

                <!-- Logo -->
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6,0,0,30">
                    <Border Width="40" Height="40" CornerRadius="11" Background="{StaticResource PrimaryBrush}">
                        <TextBlock Text="🍦" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Siri Ice Cream" Foreground="White" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Text="Shop manager" Foreground="#B58FA5" FontSize="11" />
                    </StackPanel>
                </StackPanel>

                <!-- User card and sign out (bottom) -->
                <StackPanel DockPanel.Dock="Bottom">
                    <Border Height="1" Background="#3F2235" Margin="0,0,0,16" />
                    <StackPanel Orientation="Horizontal" Margin="4,0,0,14">
                        <Border Width="40" Height="40" CornerRadius="20" Background="{StaticResource PrimaryBrush}">
                            <TextBlock Text="{Binding Initials}" Foreground="White" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding UserName}" Foreground="White" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" MaxWidth="150" />
                            <Border Background="#4D2A40" CornerRadius="8" Padding="8,1" Margin="0,4,0,0"
                                    HorizontalAlignment="Left">
                                <TextBlock Text="{Binding RoleDisplayName}" Foreground="#F8BBD0" FontSize="11"
                                           FontWeight="SemiBold" />
                            </Border>
                        </StackPanel>
                    </StackPanel>
                    <Button Command="{Binding LogoutCommand}" Style="{StaticResource NavButton}" Margin="0">
                        <StackPanel Orientation="Horizontal">
                            <!-- Standard "sign out" icon (a door with an arrow) -->
                            <TextBlock Text="&#xF3B1;" FontFamily="{StaticResource IconFont}" FontSize="15"
                                       VerticalAlignment="Center" Margin="0,0,14,0" />
                            <TextBlock Text="Sign out" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Menu -->
                <StackPanel>
                    <TextBlock Text="MENU" Foreground="#8C6A7E" FontSize="11" FontWeight="SemiBold" Margin="8,0,0,10" />
                    <Button Command="{Binding ShowInventoryCommand}" Tag="{Binding IsInventoryActive}"
                            Style="{StaticResource NavButton}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE719;" FontFamily="{StaticResource IconFont}" FontSize="16"
                                       VerticalAlignment="Center" Margin="0,0,14,0" />
                            <TextBlock Text="Inventory" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding ShowCustomersCommand}" Tag="{Binding IsCustomersActive}"
                            Style="{StaticResource NavButton}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE716;" FontFamily="{StaticResource IconFont}" FontSize="16"
                                       VerticalAlignment="Center" Margin="0,0,14,0" />
                            <TextBlock Text="Customers" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ================= PAGE ================= -->
        <DockPanel Grid.Column="1">

            <!-- Header: page title and connection -->
            <Border DockPanel.Dock="Top" Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="28,18">
                <DockPanel>
                    <Border DockPanel.Dock="Right" Background="{StaticResource SuccessBackBrush}" CornerRadius="12"
                            Padding="10,4" VerticalAlignment="Center" ToolTip="{Binding ServerDisplay}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="{StaticResource SuccessBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="Connected" Foreground="{StaticResource SuccessBrush}" FontSize="12"
                                       FontWeight="SemiBold" Margin="6,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <StackPanel>
                        <TextBlock Text="{Binding PageTitle}" Style="{StaticResource PageTitle}" />
                        <TextBlock Text="{Binding PageSubtitle}" Style="{StaticResource HintText}" FontSize="13"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- The current page. Its DataTemplate (above) decides how it looks. -->
            <ContentControl Content="{Binding CurrentPage}" Margin="28,24" Focusable="False" />
        </DockPanel>
    </Grid>
</Window>
