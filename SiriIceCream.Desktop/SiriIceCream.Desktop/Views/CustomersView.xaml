<UserControl x:Class="SiriIceCream.Desktop.Views.CustomersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SiriIceCream.Desktop.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:CustomersViewModel}"
             d:DesignWidth="1000" d:DesignHeight="650">

    <UserControl.Resources>
        <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

        <Style x:Key="StatLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        </Style>

        <Style x:Key="StatValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>

        <!-- Small square icon at the right of each summary card -->
        <Style x:Key="StatIconBox" TargetType="Border">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Background" Value="{StaticResource PrimarySoftBrush}" />
        </Style>

        <Style x:Key="StatIcon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="ButtonIcon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />  <!-- summary cards -->
            <RowDefinition Height="Auto" />  <!-- caption under the cards -->
            <RowDefinition Height="Auto" />  <!-- search bar and New customer -->
            <RowDefinition Height="Auto" />  <!-- messages -->
            <RowDefinition Height="*" />     <!-- table and form -->
        </Grid.RowDefinitions>

        <!-- ================= SUMMARY CARDS ================= -->
        <UniformGrid Grid.Row="0" Columns="3">
            <!-- Each card: a white background with shadow, and the content on top
                 (keeping the text out of the shadow keeps it sharp). -->
            <Grid Margin="0,0,14,0">
                <Border Style="{StaticResource Card}" />
                <DockPanel Margin="18,14">
                    <Border DockPanel.Dock="Right" Style="{StaticResource StatIconBox}">
                        <TextBlock Text="&#xE716;" Style="{StaticResource StatIcon}" />
                    </Border>
                    <StackPanel>
                        <TextBlock Text="Customers" Style="{StaticResource StatLabel}" />
                        <TextBlock Text="{Binding TotalCustomers}" Style="{StaticResource StatValue}" />
                    </StackPanel>
                </DockPanel>
            </Grid>

            <Grid Margin="0,0,14,0">
                <Border Style="{StaticResource Card}" />
                <DockPanel Margin="18,14">
                    <Border DockPanel.Dock="Right" Style="{StaticResource StatIconBox}"
                            Background="{StaticResource SuccessBackBrush}">
                        <TextBlock Text="&#xE717;" Style="{StaticResource StatIcon}"
                                   Foreground="{StaticResource SuccessBrush}" />
                    </Border>
                    <StackPanel>
                        <TextBlock Text="With phone number" Style="{StaticResource StatLabel}" />
                        <TextBlock Text="{Binding WithPhoneCount}" Style="{StaticResource StatValue}" />
                    </StackPanel>
                </DockPanel>
            </Grid>

            <Grid>
                <Border Style="{StaticResource Card}" />
                <DockPanel Margin="18,14">
                    <Border DockPanel.Dock="Right" Style="{StaticResource StatIconBox}"
                            Background="{StaticResource WarningBackBrush}">
                        <TextBlock Text="&#xE7BA;" Style="{StaticResource StatIcon}"
                                   Foreground="{StaticResource WarningBrush}" />
                    </Border>
                    <StackPanel>
                        <TextBlock Text="Missing phone number" Style="{StaticResource StatLabel}" />
                        <TextBlock Text="{Binding WithoutPhoneCount}" Style="{StaticResource StatValue}" />
                    </StackPanel>
                </DockPanel>
            </Grid>
        </UniformGrid>

        <TextBlock Grid.Row="1" Text="{Binding SummaryCaption}" Style="{StaticResource HintText}" Margin="2,10,0,14" />

        <!-- ================= SEARCH BAR ================= -->
        <DockPanel Grid.Row="2" Margin="0,2,0,14">
            <Button DockPanel.Dock="Right" Command="{Binding NewCommand}" Style="{StaticResource PrimaryButton}" Margin="0"
                    Visibility="{Binding CanAddCustomers, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE710;" Style="{StaticResource ButtonIcon}" />
                    <TextBlock Text="New customer" />
                </StackPanel>
            </Button>

            <StackPanel Orientation="Horizontal">
                <!-- Search box with an icon and a placeholder text -->
                <Grid Width="320" Margin="0,0,8,0">
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Padding="34,0,10,0">
                        <TextBox.InputBindings>
                            <!-- Pressing Enter in the box also searches -->
                            <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                    <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="14"
                               Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"
                               Margin="12,0,0,0" IsHitTestVisible="False" />
                    <TextBlock Text="Search customers by name…" FontSize="14" Foreground="{StaticResource MutedBrush}"
                               VerticalAlignment="Center" Margin="36,0,0,0" IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SearchText}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
                <Button Content="Search" Command="{Binding SearchCommand}" />
                <Button Content="Clear" Command="{Binding ClearSearchCommand}" Style="{StaticResource GhostButton}" />
                <Button Command="{Binding LoadCommand}" Style="{StaticResource GhostButton}" ToolTip="Reload from the server">
                    <TextBlock Text="&#xE72C;" FontFamily="{StaticResource IconFont}" FontSize="14" />
                </Button>
            </StackPanel>
        </DockPanel>

        <!-- ================= MESSAGES ================= -->
        <StackPanel Grid.Row="3">
            <Border Style="{StaticResource ErrorBox}"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE783;" FontFamily="{StaticResource IconFont}" Foreground="{StaticResource DangerBrush}"
                               VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource SuccessBox}"
                    Visibility="{Binding HasStatus, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFont}" Foreground="{StaticResource SuccessBrush}"
                               VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource SuccessBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- ================= TABLE + FORM ================= -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="350" />
            </Grid.ColumnDefinitions>

            <!-- Table card -->
            <Grid Grid.Column="0">
                <Border Style="{StaticResource Card}" />
                <Grid Margin="12,10,12,12">
                    <ProgressBar IsIndeterminate="True" VerticalAlignment="Top"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />

                    <!-- Selecting a row loads it into the form. -->
                    <DataGrid ItemsSource="{Binding Customers}"
                              SelectedItem="{Binding SelectedCustomer, Mode=TwoWay}"
                              BorderThickness="0" Margin="0,4,0,0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Binding="{Binding Id}" Width="50">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Avatar circle with initials, then the name -->
                            <DataGridTemplateColumn Header="CUSTOMER" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="30" Height="30" CornerRadius="15"
                                                    Background="{StaticResource PrimarySoftBrush}" Margin="0,0,10,0">
                                                <TextBlock Text="{Binding Initials}" FontSize="11" FontWeight="Bold"
                                                           Foreground="{StaticResource PrimaryDarkBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="EMAIL" Binding="{Binding Email}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Shows a dash (in grey) when there is no phone number -->
                            <DataGridTextColumn Header="PHONE" Binding="{Binding PhoneDisplay}" Width="140">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasPhone}" Value="False">
                                                <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Empty state: shown when there are no rows (and nothing is loading) -->
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding HasNoCustomers}" Value="True" />
                                            <Condition Binding="{Binding IsBusy}" Value="False" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="&#xE716;" FontFamily="{StaticResource IconFont}" FontSize="32"
                                   Foreground="{StaticResource BorderStrongBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="No customers found" Style="{StaticResource SectionTitle}"
                                   HorizontalAlignment="Center" Margin="0,12,0,4" />
                        <TextBlock Text="Try another search, or click Clear to see all customers."
                                   Style="{StaticResource HintText}" HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- Form card -->
            <Grid Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Top">
                <Border Style="{StaticResource Card}" />
                <!-- Shown instead of the form when this role cannot add and nothing is selected -->
                <StackPanel Margin="22,28" HorizontalAlignment="Center">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShowForm}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="&#xE70F;" FontFamily="{StaticResource IconFont}" FontSize="28"
                               Foreground="{StaticResource BorderStrongBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="Edit a customer" Style="{StaticResource SectionTitle}"
                               HorizontalAlignment="Center" Margin="0,12,0,4" />
                    <TextBlock Text="Select a row in the table to change its details."
                               Style="{StaticResource HintText}" TextAlignment="Center" TextWrapping="Wrap" />
                </StackPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="22,20"
                              Visibility="{Binding ShowForm, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Text="{Binding FormTitle}" Style="{StaticResource SectionTitle}" Margin="0,0,0,2" />
                        <TextBlock Text="{Binding FormSubtitle}" Style="{StaticResource HintText}" />

                        <TextBlock Text="Full name" Style="{StaticResource FieldLabel}" Margin="0,16,0,6" />
                        <TextBox Text="{Binding FormName, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Text="Email" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding FormEmail, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Text="Phone (optional)" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding FormPhone, UpdateSourceTrigger=PropertyChanged}" />

                        <StackPanel Orientation="Horizontal" Margin="0,22,0,0">
                            <Button Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE74E;" Style="{StaticResource ButtonIcon}" />
                                    <TextBlock Text="Save" />
                                </StackPanel>
                            </Button>
                            <Button Content="Cancel" Command="{Binding CancelCommand}"
                                    Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>

                        <!-- Delete (only for owners, when a customer is selected) -->
                        <StackPanel Visibility="{Binding ShowDeleteButton, Converter={StaticResource BoolToVisibility}}">
                            <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,20,0,16" />
                            <Button Command="{Binding DeleteCommand}" Style="{StaticResource DangerButton}"
                                    HorizontalAlignment="Left" Margin="0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE74D;" Style="{StaticResource ButtonIcon}" />
                                    <TextBlock Text="Delete customer" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <TextBlock Text="Tip: select a row in the table to edit it."
                                   Style="{StaticResource HintText}" Margin="0,18,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
