<UserControl x:Class="SiriIceCream.Desktop.Views.ItemsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SiriIceCream.Desktop.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ItemsViewModel}"
             d:DesignWidth="1000" d:DesignHeight="650">

    <UserControl.Resources>
        <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

        <Style x:Key="StatLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        </Style>

        <Style x:Key="StatValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>

        <!-- Small square icon at the right of each summary card -->
        <Style x:Key="StatIconBox" TargetType="Border">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Background" Value="{StaticResource PrimarySoftBrush}" />
        </Style>

        <Style x:Key="StatIcon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="ButtonIcon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />  <!-- summary cards -->
            <RowDefinition Height="Auto" />  <!-- caption under the cards -->
            <RowDefinition Height="Auto" />  <!-- what this role may do -->
            <RowDefinition Height="Auto" />  <!-- search bar and New item -->
            <RowDefinition Height="Auto" />  <!-- messages -->
            <RowDefinition Height="*" />     <!-- table and form -->
        </Grid.RowDefinitions>

        <!-- ================= SUMMARY CARDS ================= -->
        <UniformGrid Grid.Row="0" Columns="4">
            <!-- Each card: a white background with shadow, and the content on top
                 (keeping the text out of the shadow keeps it sharp). -->
            <Grid Margin="0,0,14,0">
                <Border Style="{StaticResource Card}" />
                <DockPanel Margin="18,14">
                    <Border DockPanel.Dock="Right" Style="{StaticResource StatIconBox}">
                        <TextBlock Text="&#xE719;" Style="{StaticResource StatIcon}" />
                    </Border>
                    <StackPanel>
                        <TextBlock Text="Items" Style="{StaticResource StatLabel}" />
                        <TextBlock Text="{Binding TotalItems}" Style="{StaticResource StatValue}" />
                    </StackPanel>
                </DockPanel>
            </Grid>

            <Grid Margin="0,0,14,0">
                <Border Style="{StaticResource Card}" />
                <DockPanel Margin="18,14">
                    <Border DockPanel.Dock="Right" Style="{StaticResource StatIconBox}">
                        <TextBlock Text="&#xE7B8;" Style="{StaticResource StatIcon}" />
                    </Border>
                    <StackPanel>
                        <TextBlock Text="Units in stock" Style="{StaticResource StatLabel}" />
                        <TextBlock Text="{Binding TotalUnits}" Style="{StaticResource StatValue}" />
                    </StackPanel>
                </DockPanel>
            </Grid>

            <Grid Margin="0,0,14,0">
                <Border Style="{StaticResource Card}" />
                <DockPanel Margin="18,14">
                    <Border DockPanel.Dock="Right" Style="{StaticResource StatIconBox}"
                            Background="{StaticResource WarningBackBrush}">
                        <TextBlock Text="&#xE7BA;" Style="{StaticResource StatIcon}"
                                   Foreground="{StaticResource WarningBrush}" />
                    </Border>
                    <StackPanel>
                        <TextBlock Text="Low stock (under 10)" Style="{StaticResource StatLabel}" />
                        <TextBlock Text="{Binding LowStockCount}" Style="{StaticResource StatValue}" />
                    </StackPanel>
                </DockPanel>
            </Grid>

            <Grid>
                <Border Style="{StaticResource Card}" />
                <DockPanel Margin="18,14">
                    <Border DockPanel.Dock="Right" Style="{StaticResource StatIconBox}"
                            Background="{StaticResource SuccessBackBrush}">
                        <TextBlock Text="Rs" FontWeight="Bold" FontSize="13" Foreground="{StaticResource SuccessBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel>
                        <TextBlock Text="Stock value" Style="{StaticResource StatLabel}" />
                        <TextBlock Text="{Binding StockValueDisplay}" Style="{StaticResource StatValue}" FontSize="20"
                                   Margin="0,9,0,0" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </DockPanel>
            </Grid>
        </UniformGrid>

        <TextBlock Grid.Row="1" Text="{Binding SummaryCaption}" Style="{StaticResource HintText}" Margin="2,10,0,14" />

        <!-- ================= ROLE HINT ================= -->
        <Border Grid.Row="2" Style="{StaticResource InfoBox}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE946;" FontFamily="{StaticResource IconFont}" Foreground="{StaticResource InfoBrush}"
                           VerticalAlignment="Center" Margin="0,0,10,0" />
                <TextBlock Text="{Binding PermissionHint}" Foreground="{StaticResource InfoBrush}" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- ================= SEARCH BAR ================= -->
        <DockPanel Grid.Row="3" Margin="0,2,0,14">
            <Button DockPanel.Dock="Right" Command="{Binding NewCommand}" Style="{StaticResource PrimaryButton}" Margin="0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE710;" Style="{StaticResource ButtonIcon}" />
                    <TextBlock Text="New item" />
                </StackPanel>
            </Button>

            <StackPanel Orientation="Horizontal">
                <!-- Search box with an icon and a placeholder text -->
                <Grid Width="320" Margin="0,0,8,0">
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Padding="34,0,10,0">
                        <TextBox.InputBindings>
                            <!-- Pressing Enter in the box also searches -->
                            <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                    <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="14"
                               Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"
                               Margin="12,0,0,0" IsHitTestVisible="False" />
                    <TextBlock Text="Search items by name…" FontSize="14" Foreground="{StaticResource MutedBrush}"
                               VerticalAlignment="Center" Margin="36,0,0,0" IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SearchText}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
                <Button Content="Search" Command="{Binding SearchCommand}" />
                <Button Content="Clear" Command="{Binding ClearSearchCommand}" Style="{StaticResource GhostButton}" />
                <Button Command="{Binding LoadCommand}" Style="{StaticResource GhostButton}" ToolTip="Reload from the server">
                    <TextBlock Text="&#xE72C;" FontFamily="{StaticResource IconFont}" FontSize="14" />
                </Button>
            </StackPanel>
        </DockPanel>

        <!-- ================= MESSAGES ================= -->
        <StackPanel Grid.Row="4">
            <Border Style="{StaticResource ErrorBox}"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE783;" FontFamily="{StaticResource IconFont}" Foreground="{StaticResource DangerBrush}"
                               VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource SuccessBox}"
                    Visibility="{Binding HasStatus, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFont}" Foreground="{StaticResource SuccessBrush}"
                               VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource SuccessBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- ================= TABLE + FORM ================= -->
        <Grid Grid.Row="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="350" />
            </Grid.ColumnDefinitions>

            <!-- Table card -->
            <Grid Grid.Column="0">
                <Border Style="{StaticResource Card}" />
                <Grid Margin="12,10,12,12">
                    <ProgressBar IsIndeterminate="True" VerticalAlignment="Top"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />

                    <!-- Selecting a row loads it into the form. -->
                    <DataGrid ItemsSource="{Binding Items}"
                              SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                              BorderThickness="0" Margin="0,4,0,0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Binding="{Binding Id}" Width="50">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="NAME" Binding="{Binding Name}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTemplateColumn Header="CATEGORY" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource Badge}">
                                            <TextBlock Text="{Binding CategoryName}" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{StaticResource PrimaryDarkBrush}" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="PRICE" Binding="{Binding Price, StringFormat='Rs. {0:N2}'}" Width="110" />

                            <DataGridTextColumn Header="QTY" Binding="{Binding Quantity}" Width="60" />

                            <DataGridTemplateColumn Header="STATUS" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <!-- Green, amber or red, depending on the stock -->
                                        <Border CornerRadius="10" Padding="8,2" HorizontalAlignment="Left">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{StaticResource SuccessBackBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding StockStatus}" Value="Low stock">
                                                            <Setter Property="Background" Value="{StaticResource WarningBackBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding StockStatus}" Value="Out of stock">
                                                            <Setter Property="Background" Value="{StaticResource ErrorBackBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding StockStatus}" FontSize="12" FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding StockStatus}" Value="Low stock">
                                                                <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding StockStatus}" Value="Out of stock">
                                                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Empty state: shown when there are no rows (and nothing is loading) -->
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding HasNoItems}" Value="True" />
                                            <Condition Binding="{Binding IsBusy}" Value="False" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="32"
                                   Foreground="{StaticResource BorderStrongBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="No items found" Style="{StaticResource SectionTitle}"
                                   HorizontalAlignment="Center" Margin="0,12,0,4" />
                        <TextBlock Text="Try another search, or click Clear to see all items."
                                   Style="{StaticResource HintText}" HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- Form card -->
            <Grid Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Top">
                <Border Style="{StaticResource Card}" />
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="22,20">
                    <StackPanel>
                        <TextBlock Text="{Binding FormTitle}" Style="{StaticResource SectionTitle}" Margin="0,0,0,2" />
                        <TextBlock Text="{Binding FormSubtitle}" Style="{StaticResource HintText}" />

                        <TextBlock Text="Name" Style="{StaticResource FieldLabel}" Margin="0,16,0,6" />
                        <TextBox Text="{Binding FormName, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Text="Category (flavor)" Style="{StaticResource FieldLabel}" />
                        <ComboBox ItemsSource="{Binding Categories}"
                                  SelectedItem="{Binding FormCategory, Mode=TwoWay}"
                                  DisplayMemberPath="Name" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Price (Rs.)" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding FormPrice, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Quantity" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding FormQuantity, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,22,0,0">
                            <Button Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE74E;" Style="{StaticResource ButtonIcon}" />
                                    <TextBlock Text="Save" />
                                </StackPanel>
                            </Button>
                            <Button Content="Cancel" Command="{Binding CancelCommand}"
                                    Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>

                        <!-- Delete (only when an item is selected) -->
                        <StackPanel Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}">
                            <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,20,0,16" />
                            <Button Command="{Binding DeleteCommand}" Style="{StaticResource DangerButton}"
                                    HorizontalAlignment="Left" Margin="0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE74D;" Style="{StaticResource ButtonIcon}" />
                                    <TextBlock Text="Delete item" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <TextBlock Text="Tip: select a row in the table to edit it."
                                   Style="{StaticResource HintText}" Margin="0,18,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
