<Window x:Class="SiriIceCream.Desktop.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:SiriIceCream.Desktop.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:LoginViewModel}"
        Title="Siri Ice Cream - Sign in"
        Width="940" Height="600"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackgroundBrush}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="400" />  <!-- brand panel -->
            <ColumnDefinition Width="*" />    <!-- sign-in form -->
        </Grid.ColumnDefinitions>

        <!-- ================= LEFT: brand panel ================= -->
        <Border Grid.Column="0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#D81B60" Offset="0" />
                    <GradientStop Color="#6A1B4D" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>

            <Grid Margin="44,48">
                <!-- Logo and name -->
                <StackPanel VerticalAlignment="Top">
                    <Border Width="68" Height="68" CornerRadius="18" Background="#33FFFFFF" HorizontalAlignment="Left">
                        <TextBlock Text="🍦" FontSize="36" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Siri Ice Cream" Foreground="White" FontSize="32" FontWeight="Bold" Margin="0,28,0,0" />
                    <TextBlock Text="Inventory and customer management for your shop."
                               Foreground="#F8BBD0" FontSize="15" TextWrapping="Wrap" Margin="0,8,0,0" />
                </StackPanel>

                <!-- What the app does -->
                <StackPanel VerticalAlignment="Bottom">
                    <TextBlock Foreground="White" FontSize="14" Margin="0,0,0,12">
                        <Run Text="✓" FontWeight="Bold" /><Run Text="   Track every flavor and its stock" />
                    </TextBlock>
                    <TextBlock Foreground="White" FontSize="14" Margin="0,0,0,12">
                        <Run Text="✓" FontWeight="Bold" /><Run Text="   Keep customer records up to date" />
                    </TextBlock>
                    <TextBlock Foreground="White" FontSize="14" Margin="0,0,0,28">
                        <Run Text="✓" FontWeight="Bold" /><Run Text="   Role-based access for your whole team" />
                    </TextBlock>
                    <TextBlock Text="© 2026 Siri Ice Cream" Foreground="#F8BBD0" FontSize="11" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= RIGHT: sign-in form ================= -->
        <StackPanel Grid.Column="1" Width="360" HorizontalAlignment="Center" VerticalAlignment="Center">

            <TextBlock Text="Welcome back" Style="{StaticResource TitleText}" FontSize="28" />
            <TextBlock Text="Sign in to your account to continue." Style="{StaticResource HintText}"
                       FontSize="14" Margin="0,6,0,24" />

            <!-- Error message (only visible when there is an error) -->
            <Border Style="{StaticResource ErrorBox}"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" />
            </Border>

            <TextBlock Text="Username" Style="{StaticResource FieldLabel}" Margin="0,0,0,6" />
            <TextBox x:Name="UsernameBox" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Text="Password" Style="{StaticResource FieldLabel}" />
            <!-- The password box and a normal text box sit in the same place. The eye button
                 swaps them, so the password can be shown as plain text and hidden again.
                 PasswordBox cannot use data binding; the code-behind copies the password. -->
            <Grid>
                <PasswordBox x:Name="PasswordBox" Padding="10,0,42,0"
                             PasswordChanged="PasswordBox_PasswordChanged"
                             KeyUp="PasswordBox_KeyUp"
                             GotKeyboardFocus="PasswordBox_FocusChanged"
                             LostKeyboardFocus="PasswordBox_FocusChanged" />
                <TextBox x:Name="PasswordTextBox" Padding="10,0,42,0" Visibility="Collapsed"
                         TextChanged="PasswordTextBox_TextChanged"
                         KeyUp="PasswordBox_KeyUp"
                         GotKeyboardFocus="PasswordBox_FocusChanged"
                         LostKeyboardFocus="PasswordBox_FocusChanged" />
                <Button x:Name="ShowPasswordButton" Click="ShowPasswordButton_Click"
                        HorizontalAlignment="Right" Width="38" Margin="0,1,1,1"
                        Cursor="Hand" ToolTip="Show password" Focusable="False">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="Transparent">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                    <!-- Eye icon; the code-behind switches it to "eye crossed out" while visible -->
                    <TextBlock x:Name="ShowPasswordIcon" Text="&#xE7B3;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                               FontSize="15" Foreground="{StaticResource MutedBrush}" />
                </Button>
            </Grid>
            <TextBlock x:Name="CapsLockWarning" Text="⚠ Caps Lock is on"
                       Foreground="{StaticResource WarningBrush}" FontSize="12" Margin="0,6,0,0"
                       Visibility="Collapsed" />


            <!-- Sign in. The text changes to "Signing in…" while waiting for the server. -->
            <Button Command="{Binding LoginCommand}" IsDefault="True"
                    Margin="0,26,0,0" Padding="0,11" FontSize="14">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                        <Setter Property="Content" Value="Sign in" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                <Setter Property="Content" Value="Signing in…" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <!-- Demo accounts: one click fills in the username and password -->
            <Grid Margin="0,28,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Height="1" Background="{StaticResource BorderBrush}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="DEMO ACCOUNTS" Style="{StaticResource CaptionText}" Margin="12,0" />
                <Border Grid.Column="2" Height="1" Background="{StaticResource BorderBrush}" VerticalAlignment="Center" />
            </Grid>
            <UniformGrid Columns="3">
                <Button Content="Owner" Tag="owner" Click="DemoAccount_Click" Style="{StaticResource GhostButton}" />
                <Button Content="Manager" Tag="manager" Click="DemoAccount_Click" Style="{StaticResource GhostButton}" />
                <Button Content="Cashier" Tag="cashier" Click="DemoAccount_Click" Style="{StaticResource GhostButton}" Margin="0" />
            </UniformGrid>
        </StackPanel>
    </Grid>
</Window>
