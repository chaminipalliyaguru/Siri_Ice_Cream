# Copy this file to .env and change the values.
# .env is ignored by git, so your secrets stay on your computer.

# "development" or "production"
APP_ENV=development

# HTTP port
PORT=3000

# SQLite database file
DB_PATH=siri_icecream_shop.db

# Secret used to sign JWT tokens.
# In production this is REQUIRED and must be at least 32 characters.
JWT_SECRET=dev-secret-change-me